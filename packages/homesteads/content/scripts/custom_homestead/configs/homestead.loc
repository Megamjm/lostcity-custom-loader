// Interactive homestead scenery.

[homestead_portal]
name=Homestead portal
desc=A shimmering doorway to the homestead grounds.
model=furniture_bankbooth
op1=Enter
blockrange=no
category=homestead_portal

[homestead_exit_portal]
name=Return portal
desc=Takes you back to the homestead village.
model=furniture_bankbooth
op1=Leave
blockrange=no
category=homestead_portal

[homestead_chest]
name=Storage chest
desc=Your household chest.
model=furniture_chestclosed
op1=Open
forceapproach=east
category=homestead_storage

[homestead_bank_closet]
name=Bank closet
desc=A closet lined with deposit boxes.
model=furniture_bankbooth
op1=Use
blockrange=no
category=homestead_bank

[homestead_mine_hole]
name=Miner's hole
desc=A boarded shaft. It smells of wet stone.
model=outdoorfurniture_manholeclosed
op1=Climb-down
category=homestead_mine

[homestead_mine_rope]
name=Climbing rope
desc=The way back to your plot.
model=outdoorfurniture_manholeclosed
op1=Climb-up
category=homestead_mine

[homestead_for_sale]
name=Plot sign
desc=This lot is on the island grid.
model=furniture_chestclosed
width=1
length=1
op1=Read
op2=Buy
blockrange=no
category=homestead_sign

[homestead_sold_sign]
name=Plot sign
desc=Someone lives here.
model=furniture_chestclosed
width=1
length=1
op1=Read
blockrange=no
category=homestead_sign

[homestead_fish_spot]
name=Homestead pond
desc=A still pool stocked from the fortress water.
model=outdoorfurniture_manholeclosed
op1=Fish
blockrange=no
category=homestead_mine

[homestead_ladder_up]
name=Ladder
desc=Up to the second storey.
model=outdoorfurniture_manholeclosed
op1=Climb-up
blockrange=no
category=homestead_mine

[homestead_ladder_down]
name=Ladder
desc=Back down to the hall.
model=outdoorfurniture_manholeclosed
op1=Climb-down
blockrange=no
category=homestead_mine

[homestead_stairs]
name=Staircase
desc=Up to the next floor of this copy.
model=furniture_stairs
width=2
length=3
op1=Climb-up
forceapproach=south
sharelight=yes
category=homestead_mine

[homestead_stairstop]
name=Staircase
desc=Back down to the hall.
model=furniture_stairstop
width=2
length=2
op1=Climb-down
forceapproach=north
sharelight=yes
category=homestead_mine

