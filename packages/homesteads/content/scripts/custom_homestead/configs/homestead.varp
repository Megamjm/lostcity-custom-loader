// Permanent player state. These write into the .sav and survive restarts.

[homestead_house]
scope=perm

[homestead_plot]
scope=perm

[homestead_approached]
scope=perm

// Second deed. 0 = none.
[homestead_house2]
scope=perm

[homestead_plot2]
scope=perm

// Bit flags for later upgrades. Unused bits stay 0.
[homestead_flags]
scope=perm

[homestead_upgrades]
scope=perm

[homestead_upgrades2]
scope=perm

[homestead_up_slot]
scope=temp

[homestead_return]
scope=perm
type=coord

[homestead_return_set]
scope=perm

[homestead_hp_seen]
scope=temp

[homestead_combatclock]
scope=temp

[homestead_friend_plot]
scope=perm

[homestead_guest_plot]
scope=perm
