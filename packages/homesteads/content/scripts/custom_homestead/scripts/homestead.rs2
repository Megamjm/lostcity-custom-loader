// Homestead entry points, plot math, purchase, persistence.

[queue,homestead_login]
~homestead_seed_region_clerks;
~homestead_stamp_office;
if (%homestead_house ! 0) {
    ~homestead_stamp_player_house;
    settimer(homestead_keep_timer, 100);
}
if (%homestead_approached = 0) {
    settimer(homestead_agent_timer, 15);
}

[timer,homestead_agent_timer]
if (%homestead_house ! 0) {
    cleartimer(homestead_agent_timer);
    return;
}
if (~homestead_in_preview_village = true) {
    ~homestead_spawn_approaching_agent;
    cleartimer(homestead_agent_timer);
    return;
}
settimer(homestead_agent_timer, 25);

[timer,homestead_keep_timer]
if (%homestead_house = 0) {
    if (%homestead_house2 = 0) {
        cleartimer(homestead_keep_timer);
        return;
    }
}
if (~homestead_in_island = true) {
    ~homestead_stamp_player_house;
    if (%homestead_plot2 > 0) {
        if (%homestead_house2 ! 0) {
            ~homestead_stamp_house(~homestead_plot_coord(%homestead_plot2), %homestead_house2);
        }
    }
    ~homestead_stamp_office;
    ~homestead_enforce_plot;
}
if (~homestead_in_mine = true) {
    if (%homestead_house ! 12) {
        mes("This shaft is not yours.");
        ~homestead_teleport_village;
    }
}
settimer(homestead_keep_timer, 200);

[proc,homestead_in_preview_village]()(boolean)
if (inzone(0_8_8_0_0, 0_8_8_15_15, coord) = true) {
    return(true);
}
return(false);

[proc,homestead_in_island]()(boolean)
if (inzone(0_8_8_0_0, 0_10_10_63_63, coord) = true) {
    return(true);
}
return(false);

[proc,homestead_in_mine]()(boolean)
if (inzone(0_11_8_0_0, 0_11_8_63_63, coord) = true) {
    return(true);
}
return(false);

[proc,homestead_on_own_plot]()(boolean)
if (%homestead_plot > 0) {
    def_coord $origin = ~homestead_plot_coord(%homestead_plot);
    def_coord $max = movecoord($origin, 15, 0, 15);
    if (inzone($origin, $max, coord) = true) {
        return(true);
    }
}
if (%homestead_plot2 > 0) {
    def_coord $origin2 = ~homestead_plot_coord(%homestead_plot2);
    def_coord $max2 = movecoord($origin2, 15, 0, 15);
    if (inzone($origin2, $max2, coord) = true) {
        return(true);
    }
}
return(false);

[proc,homestead_enforce_plot]
if (~homestead_in_preview_village = true) {
    return;
}
if (%homestead_house = 0) {
    if (%homestead_house2 = 0) {
        mes("Those lots are fenced off until you buy a deed.");
        p_teleport(^homestead_preview_spawn);
        return;
    }
}

[proc,homestead_plot_coord](int $plot)(coord)
def_int $index = sub($plot, 1);
if ($index < 0) {
    $index = 0;
}
if ($index >= ^homestead_plot_count) {
    $index = sub(^homestead_plot_count, 1);
}
def_int $col = sub($index, multiply(divide($index, ^homestead_plot_cols), ^homestead_plot_cols));
def_int $row = divide($index, ^homestead_plot_cols);
def_int $dx = multiply($col, ^homestead_plot_size);
def_int $dz = multiply($row, ^homestead_plot_size);
return(movecoord(^homestead_island_origin, $dx, 0, $dz));

[proc,homestead_find_vacant_plot]()(int)
def_int $start = 1;
def_int $i = 0;
while ($i < ^homestead_plot_count) {
    def_int $tmp = add(sub($start, 1), $i);
    def_int $plot = add(sub($tmp, multiply(divide($tmp, ^homestead_plot_count), ^homestead_plot_count)), 1);
    def_coord $origin = ~homestead_plot_coord($plot);
    if (~homestead_plot_vacant($origin) = true) {
        return($plot);
    }
    $i = add($i, 1);
}
return(0);

[proc,homestead_assign_plot]()(int)
if (%homestead_plot > 0) {
    return(%homestead_plot);
}
def_int $plot = ~homestead_find_vacant_plot;
if ($plot = 0) {
    mes("Every plot on the island is taken.");
    return(0);
}
%homestead_plot = $plot;
return($plot);

[proc,homestead_can_buy](int $type)(boolean)
if ($type < 1 | $type > 12) {
    mes("That deed is not for sale.");
    return(false);
}
if (~homestead_busy = true) {
    return(false);
}
def_int $price = ~homestead_price($type);
if (inv_total(inv, coins) < $price) {
    mes("You need <tostring($price)> coins to buy that copy.");
    return(false);
}
return(true);

[proc,homestead_busy]()(boolean)
if (p_finduid(uid) = false) {
    return(true);
}
return(false);

[proc,homestead_take_gold](int $price)(boolean)
if ($price < 1) {
    return(true);
}
if (inv_total(inv, coins) < $price) {
    return(false);
}
inv_del(inv, coins, $price);
return(true);

[proc,homestead_give_deed](int $type)
if (inv_total(inv, land_deed) < 1) {
    inv_add(inv, land_deed, 1);
}

[proc,homestead_inv_del_all](obj $item)
def_int $n = inv_total(inv, $item);
if ($n > 0) {
    inv_del(inv, $item, $n);
}

[proc,homestead_clear_old_deed]
~homestead_inv_del_all(land_deed_small);
~homestead_inv_del_all(land_deed_medium);
~homestead_inv_del_all(land_deed_large);
~homestead_inv_del_all(land_deed_crafter);
~homestead_inv_del_all(land_deed_miner);
~homestead_inv_del_all(land_deed_blank);

[proc,homestead_buy](int $type)
if (~homestead_can_buy($type) = false) {
    return;
}
if (%homestead_plot = 0) {
    if (~homestead_assign_plot = 0) {
        ~chatnpc("<p,sad>The island is full.");
        return;
    }
}
~homestead_clear_old_deed;
def_int $price = ~homestead_price($type);
if (~homestead_take_gold($price) = false) {
    ~chatnpc("<p,neutral>Come back when you have the coins.");
    return;
}
%homestead_house = $type;
%homestead_approached = 1;
~homestead_give_deed($type);
~homestead_stamp_player_house;
settimer(homestead_keep_timer, 100);
~chatnpc("<p,happy>Sold! A copy of the <~homestead_house_name($type)> from <~homestead_region_name($type)> is on plot <tostring(%homestead_plot)>.");
~chatnpc("<p,quiz>The deed is in your pack. Read it, or use it to go home.");
