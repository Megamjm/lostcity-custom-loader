[proc,homestead_plot_col](int $plot)(int)
def_int $index = sub($plot, 1);
if ($index < 0) {
    $index = 0;
}
return(sub($index, multiply(divide($index, ^homestead_plot_cols), ^homestead_plot_cols)));

[proc,homestead_faces_east](int $plot)(boolean)
if (~homestead_plot_col($plot) = 0) {
    return(true);
}
return(false);

[proc,homestead_uses_yard_wall](int $type)(boolean)
if ($type < 4) {
    return(false);
}
if ($type = 12) {
    return(false);
}
return(true);

[proc,homestead_house_origin](coord $origin)(coord)
if (~homestead_faces_east(~homestead_plot_from_coord($origin)) = true) {
    return(movecoord($origin, 12, 0, 6));
}
return(movecoord($origin, 2, 0, 6));

[proc,homestead_sign_coord](coord $origin)(coord)
if (~homestead_faces_east(~homestead_plot_from_coord($origin)) = true) {
    return(movecoord($origin, 20, 0, 9));
}
return(movecoord($origin, -1, 0, 9));

[proc,homestead_gate_coord](coord $origin)(coord)
if (~homestead_faces_east(~homestead_plot_from_coord($origin)) = true) {
    return(movecoord($origin, 19, 0, 10));
}
return(movecoord($origin, 0, 0, 10));

[proc,homestead_street_coord](coord $origin)(coord)
if (~homestead_faces_east(~homestead_plot_from_coord($origin)) = true) {
    return(movecoord($origin, 22, 0, 10));
}
return(movecoord($origin, -2, 0, 10));

[proc,homestead_inside_coord](coord $origin)(coord)
return(movecoord(~homestead_house_origin($origin), 2, 0, 3));

[proc,homestead_stamp_yard](coord $origin)
def_boolean $east = ~homestead_faces_east(~homestead_plot_from_coord($origin));
def_int $last = 19;
def_int $x = 0;
while ($x <= $last) {
    loc_add(movecoord($origin, $x, 0, 0), brickwall, 1, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, $x, 0, $last), brickwall, 3, wall_straight, ^homestead_stamp_ticks);
    $x = add($x, 1);
}
def_int $z = 1;
while ($z < $last) {
    if ($z = 10 | $z = 11) {
        if ($east = true) {
            loc_add(movecoord($origin, 0, 0, $z), brickwall, 2, wall_straight, ^homestead_stamp_ticks);
        } else {
            loc_add(movecoord($origin, $last, 0, $z), brickwall, 0, wall_straight, ^homestead_stamp_ticks);
        }
    } else {
        loc_add(movecoord($origin, 0, 0, $z), brickwall, 2, wall_straight, ^homestead_stamp_ticks);
        loc_add(movecoord($origin, $last, 0, $z), brickwall, 0, wall_straight, ^homestead_stamp_ticks);
    }
    $z = add($z, 1);
}

[proc,homestead_stamp_backyard](coord $origin)
def_boolean $east = ~homestead_faces_east(~homestead_plot_from_coord($origin));
if ($east = true) {
    loc_add(movecoord($origin, 7, 0, 10), well, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 4, 0, 8), tree, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 8, 0, 8), oaktree, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 5, 0, 11), tree2, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 3, 0, 3), daisys, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 6, 0, 2), sunflower, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 8, 0, 4), smallfern, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 3, 0, 16), blueflower, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 7, 0, 15), daisys, 3, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 9, 0, 17), smallfern, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 5, 0, 2), rockslide3, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 3, 0, 17), rockslide4, 2, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 9, 0, 7), redflower, 2, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 3, 0, 7), thistle, 0, centrepiece_straight, ^homestead_stamp_ticks);
    if (npc_find(movecoord($origin, 6, 0, 9), chicken, 8, 0) = false) {
        npc_add(movecoord($origin, 6, 0, 9), chicken, ^homestead_stamp_ticks);
    }
    if (npc_find(movecoord($origin, 8, 0, 10), chicken_brown, 8, 0) = false) {
        npc_add(movecoord($origin, 8, 0, 10), chicken_brown, ^homestead_stamp_ticks);
    }
    if (npc_find(movecoord($origin, 7, 0, 2), sheepunsheered, 6, 0) = false) {
        npc_add(movecoord($origin, 7, 0, 2), sheepunsheered, ^homestead_stamp_ticks);
    }
    if (npc_find(movecoord($origin, 18, 0, 8), butterfly, 6, 0) = false) {
        npc_add(movecoord($origin, 18, 0, 8), butterfly, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 17, 0, 4), grass_1, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 16, 0, 7), grass_2, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 17, 0, 13), grass_3, 2, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 16, 0, 16), grass_4, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 2, 0, 5), grass_1, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 4, 0, 14), grass_3, 0, centrepiece_straight, ^homestead_stamp_ticks);
    }
} else {
    loc_add(movecoord($origin, 12, 0, 10), well, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 15, 0, 8), tree, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 11, 0, 8), oaktree, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 14, 0, 11), tree2, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 16, 0, 3), daisys, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 13, 0, 2), sunflower, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 11, 0, 4), smallfern, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 16, 0, 16), blueflower, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 12, 0, 15), daisys, 3, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 10, 0, 17), smallfern, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 14, 0, 2), rockslide3, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 16, 0, 17), rockslide4, 2, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 10, 0, 7), redflower, 2, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 16, 0, 7), thistle, 0, centrepiece_straight, ^homestead_stamp_ticks);
    if (npc_find(movecoord($origin, 13, 0, 9), chicken, 8, 0) = false) {
        npc_add(movecoord($origin, 13, 0, 9), chicken, ^homestead_stamp_ticks);
    }
    if (npc_find(movecoord($origin, 11, 0, 10), chicken_brown, 8, 0) = false) {
        npc_add(movecoord($origin, 11, 0, 10), chicken_brown, ^homestead_stamp_ticks);
    }
    if (npc_find(movecoord($origin, 12, 0, 2), sheepunsheered, 6, 0) = false) {
        npc_add(movecoord($origin, 12, 0, 2), sheepunsheered, ^homestead_stamp_ticks);
    }
    if (npc_find(movecoord($origin, 1, 0, 8), butterfly, 6, 0) = false) {
        npc_add(movecoord($origin, 1, 0, 8), butterfly, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 2, 0, 4), grass_1, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 3, 0, 7), grass_2, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 2, 0, 13), grass_3, 2, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 3, 0, 16), grass_4, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 17, 0, 5), grass_1, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 15, 0, 14), grass_3, 0, centrepiece_straight, ^homestead_stamp_ticks);
    }
}
[proc,homestead_stamp_door](coord $origin, int $type)
if ($type < 4) {
    return;
}
def_coord $home = ~homestead_house_origin($origin);
if (~homestead_faces_east(~homestead_plot_from_coord($origin)) = true) {
    loc_add(movecoord($home, 5, 0, 4), loc_1530, 0, wall_straight, ^homestead_stamp_ticks);
} else {
    loc_add(movecoord($home, 0, 0, 4), loc_1530, 2, wall_straight, ^homestead_stamp_ticks);
}

[proc,homestead_stamp_gate](coord $origin)
if (~homestead_faces_east(~homestead_plot_from_coord($origin)) = true) {
    loc_add(movecoord($origin, 20, 0, 9), homestead_sold_sign, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 20, 0, 11), standing_torch, 0, centrepiece_straight, ^homestead_stamp_ticks);
} else {
    loc_add(movecoord($origin, -1, 0, 9), homestead_sold_sign, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -1, 0, 11), standing_torch, 0, centrepiece_straight, ^homestead_stamp_ticks);
}

[proc,homestead_stamp_street_hedge](coord $origin)
def_boolean $east = ~homestead_faces_east(~homestead_plot_from_coord($origin));
def_int $z = 0;
if ($east = true) {
    while ($z <= 19) {
        if ($z = 9 | $z = 10 | $z = 11) {
        } else {
            loc_add(movecoord($origin, 20, 0, $z), smallfern, 0, centrepiece_straight, ^homestead_stamp_ticks);
            loc_add(movecoord($origin, 21, 0, $z), grass_1, 0, centrepiece_straight, ^homestead_stamp_ticks);
        }
        $z = add($z, 2);
    }
    loc_add(movecoord($origin, 20, 0, 2), grass_2, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 21, 0, 4), grass_3, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 20, 0, 6), grass_4, 2, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 21, 0, 8), smallfern, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 21, 0, 12), smallfern, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 20, 0, 14), grass_1, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 21, 0, 16), grass_2, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 20, 0, 18), grass_3, 2, centrepiece_straight, ^homestead_stamp_ticks);
} else {
    while ($z <= 19) {
        if ($z = 9 | $z = 10 | $z = 11) {
        } else {
            loc_add(movecoord($origin, -1, 0, $z), smallfern, 0, centrepiece_straight, ^homestead_stamp_ticks);
            loc_add(movecoord($origin, -2, 0, $z), grass_1, 0, centrepiece_straight, ^homestead_stamp_ticks);
        }
        $z = add($z, 2);
    }
    loc_add(movecoord($origin, -1, 0, 2), grass_2, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -2, 0, 4), grass_3, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -1, 0, 6), grass_4, 2, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -2, 0, 8), smallfern, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -2, 0, 12), smallfern, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -1, 0, 14), grass_1, 1, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -2, 0, 16), grass_2, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -1, 0, 18), grass_3, 2, centrepiece_straight, ^homestead_stamp_ticks);
}
[proc,homestead_stamp_plot_fence](coord $origin)
def_boolean $east = ~homestead_faces_east(~homestead_plot_from_coord($origin));
def_int $x;
def_int $z;
if ($east = true) {
    $x = -1;
    while ($x <= 18) {
        loc_add(movecoord($origin, $x, 0, 0), fencing, 1, wall_straight, ^homestead_stamp_ticks);
        loc_add(movecoord($origin, $x, 0, 19), fencing, 3, wall_straight, ^homestead_stamp_ticks);
        $x = add($x, 1);
    }
    $z = 1;
    while ($z <= 18) {
        loc_add(movecoord($origin, -2, 0, $z), fencing, 2, wall_straight, ^homestead_stamp_ticks);
        if ($z = 10 | $z = 11) {
        } else {
            loc_add(movecoord($origin, 19, 0, $z), fencing, 0, wall_straight, ^homestead_stamp_ticks);
        }
        $z = add($z, 1);
    }
    loc_add(movecoord($origin, 19, 0, 10), memberfencegate_l, 0, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 19, 0, 11), memberfencegate_r, 0, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -2, 0, 0), fence_terminator_left, 2, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 19, 0, 0), fence_terminator_right, 0, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, -2, 0, 19), fence_terminator_right, 2, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 19, 0, 19), fence_terminator_left, 0, wall_straight, ^homestead_stamp_ticks);
} else {
    $x = 1;
    while ($x <= 20) {
        loc_add(movecoord($origin, $x, 0, 0), fencing, 1, wall_straight, ^homestead_stamp_ticks);
        loc_add(movecoord($origin, $x, 0, 19), fencing, 3, wall_straight, ^homestead_stamp_ticks);
        $x = add($x, 1);
    }
    $z = 1;
    while ($z <= 18) {
        loc_add(movecoord($origin, 21, 0, $z), fencing, 0, wall_straight, ^homestead_stamp_ticks);
        if ($z = 10 | $z = 11) {
        } else {
            loc_add(movecoord($origin, 0, 0, $z), fencing, 2, wall_straight, ^homestead_stamp_ticks);
        }
        $z = add($z, 1);
    }
    loc_add(movecoord($origin, 0, 0, 10), memberfencegate_l, 2, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 0, 0, 11), memberfencegate_r, 2, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 0, 0, 0), fence_terminator_left, 2, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 21, 0, 0), fence_terminator_right, 0, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 0, 0, 19), fence_terminator_right, 2, wall_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($origin, 21, 0, 19), fence_terminator_left, 0, wall_straight, ^homestead_stamp_ticks);
}
[proc,homestead_stamp_frontage](coord $origin, int $type)
if (~homestead_uses_yard_wall($type) = true) {
    ~homestead_stamp_yard($origin);
}
if ($type = 1) {
    ~homestead_stamp_plot_fence($origin);
    ~homestead_stamp_backyard($origin);
}
~homestead_stamp_street_hedge($origin);
~homestead_stamp_gate($origin);
~homestead_stamp_door($origin, $type);

[proc,homestead_stamp_vacant_frontage](coord $origin)
~homestead_stamp_street_hedge($origin);
~homestead_stamp_gate($origin);
def_coord $sign = ~homestead_sign_coord($origin);
if (loc_find($sign, homestead_sold_sign) = false) {
    if (loc_find($sign, homestead_for_sale) = false) {
        loc_add($sign, homestead_for_sale, 0, centrepiece_straight, ^homestead_stamp_ticks);
    }
}
[proc,homestead_stamp_cottage_ceiling](coord $origin)
def_int $x = 0;
def_int $z;
while ($x <= 5) {
    $z = 0;
    while ($z <= 7) {
        loc_add(movecoord($origin, $x, 1, $z), woodfloor_crumbly_l, 0, centrepiece_straight, ^homestead_stamp_ticks);
        $z = add($z, 1);
    }
    $x = add($x, 1);
}

