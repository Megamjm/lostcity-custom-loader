// Door faces the south avenue. Sign sits on the east curb.

[proc,homestead_stamp_frontage](coord $origin)
loc_add(movecoord($origin, 2, 0, 0), loc_1530, 1, wall_straight, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 2, 0, -1), standing_torch, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 16, 0, 1), homestead_sold_sign, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 16, 0, 2), standing_torch, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 2, 0, 16), standing_torch, 0, centrepiece_straight, ^homestead_stamp_ticks);

[proc,homestead_sign_coord](coord $origin)(coord)
return(movecoord($origin, 16, 0, 1));
