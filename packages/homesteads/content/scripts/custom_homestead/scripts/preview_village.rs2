// Compact showhomes west of plot 1 so they do not overlap 0_8_8_16_16.

[proc,homestead_stamp_lid](coord $origin)
loc_add(movecoord($origin, 1, 1, 1), timberwall, 1, wall_squarecorner, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 4, 1, 1), timberwall, 0, wall_squarecorner, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 1, 1, 6), timberwall, 2, wall_squarecorner, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 4, 1, 6), timberwall, 3, wall_squarecorner, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 2, 1, 1), brickwall, 1, wall_straight, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 3, 1, 1), brickwall, 1, wall_straight, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 2, 1, 6), brickwall, 3, wall_straight, ^homestead_stamp_ticks);
loc_add(movecoord($origin, 3, 1, 6), brickwall, 3, wall_straight, ^homestead_stamp_ticks);

[proc,homestead_preview_coord](int $i)(coord)
def_int $col = sub($i, multiply(divide($i, 2), 2));
def_int $row = divide($i, 2);
def_int $dx = multiply($col, 7);
def_int $dz = multiply($row, 12);
return(movecoord(^homestead_preview_origin, $dx, 0, add($dz, 2)));

[proc,homestead_preview_type](int $i)(int)
if ($i = 0) return(1);
if ($i = 1) return(2);
if ($i = 2) return(3);
return(4);

[proc,homestead_build_preview]
if (npc_find(^homestead_agent_stand, homestead_caretaker, 8, 0) = false) {
    npc_add(^homestead_agent_stand, homestead_caretaker, ^homestead_npc_ticks);
}
loc_add(^homestead_preview_spawn, homestead_portal, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(^homestead_island_exit, homestead_exit_portal, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(movecoord(^homestead_preview_origin, 8, 0, 8), well, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(movecoord(^homestead_preview_origin, 7, 0, 8), standing_torch, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(movecoord(^homestead_preview_origin, 9, 0, 8), standing_torch, 0, centrepiece_straight, ^homestead_stamp_ticks);
def_int $i = 0;
while ($i < 4) {
    def_coord $at = ~homestead_preview_coord($i);
    ~stamp_lumbridge_cottage($at);
    ~homestead_stamp_lid($at);
    loc_add(movecoord($at, 2, 0, 0), loc_1530, 1, wall_straight, ^homestead_stamp_ticks);
    loc_add($at, homestead_for_sale, 0, centrepiece_straight, ^homestead_stamp_ticks);
    loc_add(movecoord($at, 2, 0, -1), standing_torch, 0, centrepiece_straight, ^homestead_stamp_ticks);
    $i = add($i, 1);
}
if (npc_find(movecoord(^homestead_preview_origin, 8, 0, 6), chicken, 6, 0) = false) {
    npc_add(movecoord(^homestead_preview_origin, 8, 0, 6), chicken, ^homestead_npc_ticks);
    npc_add(movecoord(^homestead_preview_origin, 9, 0, 10), chicken, ^homestead_npc_ticks);
}

[proc,homestead_walk_preview]
p_teleport(movecoord(^homestead_preview_origin, 8, 0, 6));
mes("The yard west of plot 1. Four compact copies.");

[debugproc,homestead_setup]
if (p_finduid(uid) = false) {
    return;
}
~homestead_build_preview;
~homestead_seed_region_clerks;
mes("Homestead island, showhomes and town clerks are in.");

[debugproc,homestead_here]
if (p_finduid(uid) = false) {
    return;
}
mes("house=<tostring(%homestead_house)> plot=<tostring(%homestead_plot)>");

[debugproc,homestead_grant]
if (p_finduid(uid) = false) {
    return;
}
%homestead_house = 1;
if (~homestead_assign_plot = 0) {
    return;
}
~homestead_give_deed(1);
~homestead_stamp_player_house;
~homestead_stamp_lid(~homestead_plot_coord(%homestead_plot));
mes("Debug: Lumbridge cottage granted on plot <tostring(%homestead_plot)>.");

[debugproc,homestead_go]
if (p_finduid(uid) = false) {
    return;
}
if (%homestead_house = 0) {
    p_teleport(^homestead_preview_spawn);
} else {
    ~homestead_teleport_home;
}
