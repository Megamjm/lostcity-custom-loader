// World clerks. New-buyer ferry, bound deed, guest book.

[opnpc1,_homestead_clerk]
def_int $style = npc_param(homestead_style);
if ($style < 1 | $style > 12) {
    $style = 1;
}
~chatnpc("<p,happy>A nice home, isn't it? A copy can stand on the island.");
~chatnpc("<p,quiz>A <~homestead_house_name($style)>. <tostring(~homestead_price($style))> coins.");
if (%homestead_house = 0) {
    def_int $new = ~p_choice5("Take me to the island.", 1, "I'll take a copy.", 2, "I lost a deed.", 3, "More.", 4, "No thanks.", 5);
    if ($new = 1) {
        ~homestead_go(^homestead_preview_spawn);
        mes("The clerk sends you to the green.");
    } else if ($new = 2) {
        ~homestead_buy($style);
    } else if ($new = 3) {
        ~homestead_reissue_deed;
    } else if ($new = 4) {
        @homestead_clerk_more;
    }
    return;
}
~chatnpc("<p,neutral>Plot <tostring(%homestead_plot)> is bound to your name.");
def_int $own = ~p_choice5("Take me home.", 1, "I lost my deed.", 2, "Send me back.", 3, "More.", 4, "Goodbye.", 5);
if ($own = 1) {
    if (~homestead_can_teleport = false) {
        return;
    }
    ~homestead_go(movecoord(~homestead_plot_coord(%homestead_plot), 3, 0, 2));
} else if ($own = 2) {
    ~homestead_reissue_deed;
} else if ($own = 3) {
    ~homestead_send_back;
} else if ($own = 4) {
    @homestead_clerk_more;
}

[label,homestead_clerk_more]
def_int $m = ~p_choice5("Friend paper.", 1, "Upgrade the lot.", 2, "The preview yard.", 3, "Walk me there.", 4, "Back.", 5);
if ($m = 1) {
    @homestead_guest_menu;
} else if ($m = 2) {
    @homestead_upgrade_menu;
} else if ($m = 3) {
    ~chatnpc("<p,neutral>Four empty copies behind the office. Walk them first.");
} else if ($m = 4) {
    ~homestead_walk_preview;
}

[proc,homestead_seed_region_clerks]
~homestead_seed_named(^homestead_lumbridge_clerk, clerk_lumbridge);
~homestead_seed_named(^homestead_draynor_clerk, clerk_draynor);
~homestead_seed_named(^homestead_rimmington_clerk, clerk_rimmington);
~homestead_seed_named(^homestead_falador_clerk, clerk_falador);
~homestead_seed_named(^homestead_varrock_clerk, clerk_varrock);
~homestead_seed_named(^homestead_taverley_clerk, clerk_taverley);
~homestead_seed_named(^homestead_catherby_clerk, clerk_catherby);
~homestead_seed_named(^homestead_seers_clerk, clerk_seers);
~homestead_seed_named(^homestead_ardougne_clerk, clerk_ardougne);
~homestead_seed_named(^homestead_edgeville_clerk, clerk_edgeville);

[proc,homestead_seed_named](coord $at, npc $type)
if (npc_find($at, $type, 4, 0) = true) {
    return;
}
npc_add($at, $type, ^homestead_npc_ticks);
