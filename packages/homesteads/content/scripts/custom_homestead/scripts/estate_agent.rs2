// Estate agent catalogue. Short lines. Back on every size page.

[opnpc1,estate_agent]
@estate_agent_dialog;

[label,estate_agent_dialog]
~chatnpc("<p,happy>I sell copies of houses that already stand in Gielinor.");
if (%homestead_house = 0) {
    def_int $choice = ~p_choice3("Show the list.", 1, "What is this island?", 2, "No thanks.", 3);
    if ($choice = 1) {
        @estate_agent_size_menu;
    } else if ($choice = 2) {
        ~chatnpc("<p,quiz>Land west of the old map. One hundred plots.");
        ~chatnpc("<p,neutral>Walk a real house in town first if you want.");
    }
    return;
}
def_int $owned = ~p_choice3("Take me home.", 1, "Different copy.", 2, "Goodbye.", 3);
if ($owned = 1) {
    ~homestead_teleport_home;
} else if ($owned = 2) {
    ~chatnpc("<p,neutral>Full price. Old deed is torn.");
    @estate_agent_size_menu;
}

[label,estate_agent_size_menu]
~chatnpc("<p,quiz>Size first.");
def_int $size = ~p_choice5("Small.", 1, "Medium.", 2, "Large.", 3, "Workshops.", 4, "Never mind.", 5);
if ($size = 1) {
    @estate_agent_small;
} else if ($size = 2) {
    @estate_agent_medium;
} else if ($size = 3) {
    @estate_agent_large;
} else if ($size = 4) {
    @estate_agent_work;
}

[label,estate_agent_small]
def_int $s = ~p_choice5("Lumbridge - 10k.", 1, "Draynor - 18k.", 2, "Rimmington - 35k.", 3, "Back.", 4, "Never mind.", 5);
if ($s = 1) {
    ~homestead_buy(1);
} else if ($s = 2) {
    ~homestead_buy(2);
} else if ($s = 3) {
    ~homestead_buy(3);
} else if ($s = 4) {
    @estate_agent_size_menu;
}

[label,estate_agent_medium]
def_int $m = ~p_choice5("Falador - 50k.", 1, "Varrock - 65k.", 2, "Taverley - 55k.", 3, "Catherby - 70k.", 4, "Back.", 5);
if ($m = 1) {
    ~homestead_buy(4);
} else if ($m = 2) {
    ~homestead_buy(5);
} else if ($m = 3) {
    ~homestead_buy(6);
} else if ($m = 4) {
    ~homestead_buy(7);
} else {
    @estate_agent_size_menu;
}

[label,estate_agent_large]
def_int $l = ~p_choice5("Seers - 120k.", 1, "Ardougne - 140k.", 2, "Manor - 200k.", 3, "Back.", 4, "Never mind.", 5);
if ($l = 1) {
    ~homestead_buy(8);
} else if ($l = 2) {
    ~homestead_buy(9);
} else if ($l = 3) {
    ~homestead_buy(10);
} else if ($l = 4) {
    @estate_agent_size_menu;
}

[label,estate_agent_work]
def_int $w = ~p_choice3("Crafter - 90k.", 1, "Mine hole - 45k.", 2, "Back.", 3);
if ($w = 1) {
    ~homestead_buy(11);
} else if ($w = 2) {
    ~homestead_buy(12);
} else {
    @estate_agent_size_menu;
}

[proc,homestead_spawn_approaching_agent]
if (npc_find(^homestead_agent_stand, estate_agent, 12, 0) = true) {
    return;
}
npc_add(^homestead_agent_offscreen, estate_agent, ^homestead_npc_ticks);
npc_say("You there!");
npc_walk(^homestead_agent_stand);
%homestead_approached = 1;
mes("An estate agent hurries in from the new road.");

[opnpc1,homestead_caretaker]
~chatnpc("<p,happy>Four empty copies behind the office. Walk them.");
if (%homestead_house = 0) {
    def_int $c = ~p_choice3("Where is the agent?", 1, "Walk the yard.", 2, "I'll look.", 3);
    if ($c = 1) {
        ~homestead_spawn_approaching_agent;
    } else if ($c = 2) {
        ~homestead_walk_preview;
    }
} else {
    ~chatnpc("<p,happy>Your copy is plot <tostring(%homestead_plot)>.");
}
