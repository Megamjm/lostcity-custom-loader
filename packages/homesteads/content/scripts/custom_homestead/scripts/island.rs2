[proc,homestead_teleport_home]
if (%homestead_house = 0) {
    mes("You do not own a homestead.");
    return;
}
if (%homestead_plot = 0) {
    if (~homestead_assign_plot = 0) {
        return;
    }
}
def_int $plotid = %homestead_plot;
if (%homestead_plot2 > 0) {
    def_int $pick = ~p_choice2("Plot <tostring(%homestead_plot)>.", 1, "Plot <tostring(%homestead_plot2)>.", 2);
    if ($pick = 2) {
        $plotid = %homestead_plot2;
    }
}
def_coord $plot = ~homestead_plot_coord($plotid);
~homestead_stamp_player_house;
settimer(homestead_keep_timer, 100);
mes("You step through to plot <tostring($plotid)>.");
~homestead_go(~homestead_inside_coord($plot));

[proc,homestead_teleport_village]
p_teleport(^homestead_preview_spawn);
mes("You return to the homestead square.");

[proc,homestead_stamp_grid_signs]
def_int $p = 1;
while ($p <= ^homestead_plot_count) {
    def_coord $o = ~homestead_plot_coord($p);
    if (~homestead_plot_vacant($o) = true) {
        ~homestead_stamp_vacant_frontage($o);
    }
    $p = add($p, 1);
}

[oploc1,homestead_portal]
p_delay(0);
if (%homestead_house = 0) {
    mes("The portal hums. You need a deed first.");
    return;
}
~homestead_teleport_home;

[oploc1,homestead_exit_portal]
p_delay(0);
~homestead_teleport_village;

[oploc1,homestead_chest]
mes("You open your household chest.");
inv_transmit(inv, bank_side:inv);
inv_transmit(homestead_chest_inv, bank_main:inv);
if_openmain_side(bank_main, bank_side);

[oploc1,homestead_bank_closet]
mes("You open the bank closet.");
@openbank;

[oploc1,homestead_for_sale]
def_int $n = ~homestead_plot_from_coord(coord);
if ($n = 0) {
    mes("Plot peg. See the clerks on the square.");
} else {
    mes("Plot <tostring($n)>. For sale. Clerks on the square hold the deed.");
}

[oploc2,homestead_for_sale]
mes("The office on the square handles sales.");

[oploc1,homestead_sold_sign]
def_int $n = ~homestead_plot_from_coord(coord);
if ($n = 0) {
    mes("This lot is taken.");
} else
if (%homestead_plot = $n) {
    mes("Plot <tostring($n)>. Your <~homestead_house_name(%homestead_house)>.");
} else
if (%homestead_plot2 = $n) {
    mes("Plot <tostring($n)>. Your second lot.");
} else {
    mes("Plot <tostring($n)>. Sold.");
}
[proc,homestead_stamp_shore]
loc_add(0_8_8_10_20, smallfern, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(0_8_8_9_24, smallfern, 1, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(0_8_8_11_28, thistle, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(0_8_8_8_32, smallfern, 2, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(0_8_8_10_40, thistle, 1, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(0_8_8_9_48, smallfern, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(0_8_8_12_22, rockslide3, 0, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(0_8_8_11_36, rockslide4, 2, centrepiece_straight, ^homestead_stamp_ticks);
loc_add(0_8_8_13_44, rockslide3, 1, centrepiece_straight, ^homestead_stamp_ticks);
if (npc_find(0_8_8_3_22, duck, 10, 0) = false) {
    npc_add(0_8_8_3_22, duck, ^homestead_stamp_ticks);
}
if (npc_find(0_8_8_2_30, duck, 10, 0) = false) {
    npc_add(0_8_8_2_30, duck, ^homestead_stamp_ticks);
}
if (npc_find(0_8_8_4_40, duck, 10, 0) = false) {
    npc_add(0_8_8_4_40, duck, ^homestead_stamp_ticks);
}
