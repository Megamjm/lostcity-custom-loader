[oploc1,homestead_gate]
p_delay(0);
def_int $plot = ~homestead_plot_from_coord(coord);
if (~homestead_may_open_gate($plot) = false) {
    mes("The gate is latched. Bring a deed, or be named a friend of this plot.");
    return;
}
def_coord $origin = ~homestead_plot_coord($plot);
if (~homestead_on_plot($plot) = true) {
    mes("The gate swings. It shuts behind you.");
    p_teleport(~homestead_street_coord($origin));
} else {
    mes("The latch lifts. The gate swings and shuts behind you.");
    p_teleport(~homestead_inside_coord($origin));
}
