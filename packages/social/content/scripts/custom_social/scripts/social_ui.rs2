[proc,social_other_blocks_me]()(boolean)
return(false);

[proc,social_block_add]
if (%social_block1 = 0) {
    %social_block1 = 1;
    return;
}
if (%social_block2 = 0) {
    %social_block2 = 1;
    return;
}
if (%social_block3 = 0) {
    %social_block3 = 1;
    return;
}
if (%social_block4 = 0) {
    %social_block4 = 1;
    return;
}
mes("The slate is full.");

[oploc1,social_ledger]
@social_open;

[opheld1,social_block_slate]
mes("Use this on a player to refuse their paper.");

[opplayeru,social_block_slate]
if (uid = .uid) {
    return;
}
~social_block_add;
mes("On the slate.");

[label,social_open]
if (npc_find(coord, guild_registrar, 12, 0) = true) {
} else if (npc_find(coord, clerk_oswald, 12, 0) = true) {
} else if (npc_find(coord, clerk_mabel, 12, 0) = true) {
}
~chatnpc("<p,quiz>Guild. Friends. Block. The smiley tab is still the old list.");
def_int $c = ~p_choice5("Guild roll.", 1, "Friends paper.", 2, "Block slate.", 3, "Explain the tab.", 4, "Never mind.", 5);
if ($c = 1) {
    @guild_page;
} else if ($c = 2) {
    @homestead_guest_menu;
} else if ($c = 3) {
    @social_block_page;
} else if ($c = 4) {
    ~chatnpc("<p,neutral>The 274 client paints the friends tab. This book is the GUI pack.");
}

[label,social_block_page]
mes("Slate slots used: <tostring(%social_block1)> / <tostring(%social_block2)> / <tostring(%social_block3)> / <tostring(%social_block4)>.");
def_int $b = ~p_choice5("Give me a slate.", 1, "Clear slot 1.", 2, "Clear slot 2.", 3, "Clear slot 3.", 4, "Clear slot 4.", 5);
if ($b = 1) {
    if (inv_total(inv, social_block_slate) < 1) {
        if (inv_freespace(inv) > 0) {
            inv_add(inv, social_block_slate, 1);
        }
    }
} else if ($b = 2) {
    %social_block1 = 0;
} else if ($b = 3) {
    %social_block2 = 0;
} else if ($b = 4) {
    %social_block3 = 0;
} else {
    %social_block4 = 0;
}
