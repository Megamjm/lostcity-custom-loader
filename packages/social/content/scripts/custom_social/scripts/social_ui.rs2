[proc,social_mask_on](int $flags, int $bit)(boolean)
if ($bit < 1) {
    return(false);
}
def_int $q = divide($flags, $bit);
def_int $odd = sub($q, multiply(divide($q, 2), 2));
if ($odd = 1) {
    return(true);
}
return(false);

[proc,social_mask_set](int $flags, int $bit)(int)
if (~social_mask_on($flags, $bit) = true) {
    return($flags);
}
return(add($flags, $bit));

[proc,social_other_blocks_me]()(boolean)
if (~social_mask_on(.%social_block_mask, 1) = true) {
    if (.%social_block1 = uid) {
        return(true);
    }
}
if (~social_mask_on(.%social_block_mask, 2) = true) {
    if (.%social_block2 = uid) {
        return(true);
    }
}
if (~social_mask_on(.%social_block_mask, 4) = true) {
    if (.%social_block3 = uid) {
        return(true);
    }
}
if (~social_mask_on(.%social_block_mask, 8) = true) {
    if (.%social_block4 = uid) {
        return(true);
    }
}
return(false);

[proc,social_block_add](player_uid $who)
if (~social_mask_on(%social_block_mask, 1) = false) {
    %social_block1 = $who;
    %social_block_mask = ~social_mask_set(%social_block_mask, 1);
    return;
}
if (~social_mask_on(%social_block_mask, 2) = false) {
    %social_block2 = $who;
    %social_block_mask = ~social_mask_set(%social_block_mask, 2);
    return;
}
if (~social_mask_on(%social_block_mask, 4) = false) {
    %social_block3 = $who;
    %social_block_mask = ~social_mask_set(%social_block_mask, 4);
    return;
}
if (~social_mask_on(%social_block_mask, 8) = false) {
    %social_block4 = $who;
    %social_block_mask = ~social_mask_set(%social_block_mask, 8);
    return;
}
mes("The slate is full.");

[oploc1,social_ledger]
@social_open;

[opheld1,social_block_slate]
mes("Use this on a player to refuse their paper.");

[opplayeru,social_block_slate]
if (uid = .uid) {
    return;
}
~social_block_add(.uid);
mes("On the slate.");

[label,social_open]
if (npc_find(coord, guild_registrar, 12, 0) = false) {
    if (npc_find(coord, clerk_oswald, 12, 0) = false) {
        if (npc_find(coord, clerk_mabel, 12, 0) = false) {
            mes("Open the ledger on the office desk.");
        }
    }
}
~chatnpc("<p,quiz>Guild. Friends. Block. The smiley tab is still the old list.");
def_int $c = ~p_choice5("Guild roll.", 1, "Friends paper.", 2, "Block slate.", 3, "Explain the tab.", 4, "Never mind.", 5);
if ($c = 1) {
    @guild_page;
} else if ($c = 2) {
    @homestead_guest_menu;
} else if ($c = 3) {
    @social_block_page;
} else if ($c = 4) {
    ~chatnpc("<p,neutral>The 274 client paints the friends tab. This book is the GUI pack.");
}

[label,social_block_page]
mes("Four names. Paper from them stops at the door.");
def_int $b = ~p_choice5("Give me a slate.", 1, "Clear slot 1.", 2, "Clear slot 2.", 3, "Clear slot 3.", 4, "Clear slot 4.", 5);
if ($b = 1) {
    if (inv_total(inv, social_block_slate) < 1) {
        if (inv_freespace(inv) > 0) {
            inv_add(inv, social_block_slate, 1);
        }
    }
} else if ($b = 2) {
    if (~social_mask_on(%social_block_mask, 1) = true) {
        %social_block_mask = sub(%social_block_mask, 1);
    }
} else if ($b = 3) {
    if (~social_mask_on(%social_block_mask, 2) = true) {
        %social_block_mask = sub(%social_block_mask, 2);
    }
} else if ($b = 4) {
    if (~social_mask_on(%social_block_mask, 4) = true) {
        %social_block_mask = sub(%social_block_mask, 4);
    }
} else {
    if (~social_mask_on(%social_block_mask, 8) = true) {
        %social_block_mask = sub(%social_block_mask, 8);
    }
}
